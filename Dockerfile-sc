FROM --platform=$BUILDPLATFORM python:3.14.7-alpine3.24@sha256:9e9fde4d32eedce0b661d9ab91e826b62dddf28e928c230ec55f1866cac66b01

ARG SM_USER=smuser
ARG SM_UID=1001

USER root

COPY smclient.py version sm-client /app/
COPY sm_client/ /app/sm_client/

COPY requirements-sc.txt /app/requirements.txt

WORKDIR /app/

RUN apk update && \
    apk upgrade && \
    apk add bash && \
    adduser -D -u "${SM_UID}" "${SM_USER}" && \
    pip install --upgrade pip==24.* --no-cache-dir && \
    pip install -r requirements.txt --no-cache-dir && \
    chmod 755 /app/sm-client

USER "${SM_USER}"

CMD ["python", "sm-client"]
